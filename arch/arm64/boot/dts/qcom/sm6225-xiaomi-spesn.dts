/dts-v1/;

#include <dt-bindings/usb/pd.h>
#include <dt-bindings/sound/qcom,q6afe.h>
#include <dt-bindings/sound/qcom,q6asm.h>
#include "sm6225.dtsi"
#include "pm6125.dtsi"

/ {
	model = "Xiaomi Redmi Note 11 NFC";
	compatible = "xiaomi,spesn", "qcom,sm6225";
	chassis-type = "handset";

	/* required for bootloader to select correct board */
	qcom,msm-id = <518 0x10000>;
	qcom,board-id = <0x30022 0>;
	qcom,pmic-id = <0x2D 0x0 0x0 0x0>;

	aliases {
		serial0 = &uart3;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&vol_up_n>;
		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pm6125_gpios 5 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};

	chosen {
		bootargs = "pmos.nosplash clk_ignore_unused pd_ignore_unused";

		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		framebuffer0: framebuffer@5c000000 {
			compatible = "simple-framebuffer";
			format = "a8r8g8b8";
			height = <0x960>;
			reg = <0x00 0x5c000000 0x00 0xf00000>;
			status = "okay";
			stride = <0x10e0>;
			width = <0x438>;
		};
	};

	sound {
		compatible = "qcom,qrb4210-rb2-sndcard";
		model = "SM6225-WCD9370-WSA8810-Speaker-DMIC";
		audio-routing =
				"AMIC1", "MIC BIAS1",
				"AMIC2", "MIC BIAS2",
				"AMIC3", "MIC BIAS3",

				"IN1_HPHL", "HPHL_OUT",
				"IN2_HPHR", "HPHR_OUT",
				"IN3_AUX", "AUX_OUT",

				"VA DMIC0", "VA MIC BIAS1",
				"VA DMIC1", "VA MIC BIAS1",
				"VA DMIC2", "VA MIC BIAS3",
				"VA DMIC3", "VA MIC BIAS3",

				"VA SWR_MIC0", "ADC1_OUTPUT",
				"VA SWR_MIC4", "ADC2_OUTPUT",
				"VA SWR_MIC5", "ADC3_OUTPUT",

				"TX SWR_INPUT0", "ADC1_OUTPUT",
				"TX SWR_INPUT4", "ADC2_OUTPUT",

				"SpkrLeft IN", "AUX",
				"SpkrRight IN", "AUX";

		aux-devs = <&left_spkr &right_spkr>;

		mm1-dai-link {
			link-name = "MultiMedia1";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
			};
		};

		mm2-dai-link {
			link-name = "MultiMedia2";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
			};
		};

		mm3-dai-link {
			link-name = "MultiMedia3";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
			};
		};

		wcd-playback-dai-link {
			link-name = "WCD Playback";

			cpu {
				sound-dai = <&q6afedai RX_CODEC_DMA_RX_0>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd937x 0>,
				<&swr1 0>,
				<&rxmacro 0>;
			};
		};

		// spk-dai-link {
		// 	link-name = "Speaker Playback";
		// 	cpu {
		// 		sound-dai = <&q6afedai SLIMBUS_0_RX>;
		// 	};
		// 	platform {
		// 		sound-dai = <&q6routing>;
		// 	};
		// 	codec {
		// 		sound-dai = <&left_spkr>, <&right_spkr>;
		// 	};
		// };

		wcd-capture-dai-link {
			link-name = "WCD Capture";

			cpu {
				sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd937x 1>,
				<&swr0 0>,
				<&txmacro 0>;
			};
		};

		va-dai-link {
			link-name = "VA Capture";

			cpu {
				sound-dai = <&q6afedai VA_CODEC_DMA_TX_0>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&vamacro 0>;
			};
		};
	};
};

&soc {
	rxmacro: codec@a600000 {
		compatible = "qcom,sm6115-lpass-rx-macro";
		reg = <0x0 0x0a600000 0x0 0x1000>;
		#clock-cells = <0>;
		#sound-dai-cells = <1>;
		clocks = <&q6afecc LPASS_CLK_ID_RX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_RX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&vamacro>;
		clock-names = "mclk", "npl", "dcodec", "fsgen";
		clock-output-names = "mclk";
		status = "okay";
	};

	txmacro: codec@a620000 {
		compatible = "qcom,sm6115-lpass-tx-macro";
		reg = <0x0 0x0a620000 0x0 0x1000>;
		qcom,dmic-sample-rate = <600000>;
		#clock-cells = <0>;
		#sound-dai-cells = <1>;
		pinctrl-0 = <&lpi_dmic01_active &lpi_dmic23_active>;
		pinctrl-names = "default";
		clocks = <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_TX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&vamacro>;
		clock-names = "mclk", "npl", "dcodec", "fsgen";
		clock-output-names = "mclk";
		status = "okay";
	};

	vamacro: codec@a730000 {
		compatible = "qcom,sm6115-lpass-va-macro";
		reg = <0x0 0x0a730000 0x0 0x1000>;
		qcom,dmic-sample-rate = <600000>;
		#clock-cells = <0>;
		#sound-dai-cells = <1>;
		clocks = <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_TX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
		clock-names = "mclk", "dcodec", "npl";
		clock-output-names = "fsgen";
		status = "okay";
	};

	lpass_audiocc: clock-controller@a6a9000 {
		compatible = "qcom,sm6115-lpassaudiocc";
		reg = <0x0 0x0a6a9000 0x0 0x1000>;
		#reset-cells = <1>;

		status = "okay";
	};

	lpasscc: clock-controller@a7ec000 {
		compatible = "qcom,sm6115-lpasscc";
		reg = <0x0 0x0a7ec000 0x0 0x1000>;
		#reset-cells = <1>;

		status = "okay";
	};

	wcd937x: codec {
		compatible = "qcom,wcd9370-codec";
		pinctrl-names = "default";
		pinctrl-0 = <&wcd_reset_n>;
		reset-gpios = <&tlmm 92 GPIO_ACTIVE_LOW>;
		vdd-buck-supply = <&pm6125_l14>;
		vdd-rxtx-supply = <&pm6125_l9>;
		vdd-px-supply = <&pm6125_l9>;
		qcom,micbias1-microvolt = <1800000>;
		qcom,micbias2-microvolt = <1800000>;
		qcom,micbias3-microvolt = <1800000>;
		qcom,rx-device = <&wcd937x_rx>;
		qcom,tx-device = <&wcd937x_tx>;
		#sound-dai-cells = <1>;
	};

	swr0: soundwire@a740000 {
		compatible = "qcom,soundwire-v1.6.0";
		reg = <0x0 0x0a740000 0x0 0x2000>;
		interrupts = <GIC_SPI 296 IRQ_TYPE_LEVEL_HIGH>,
		<GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>;

		pinctrl-0 = <&lpi_swr_tx_active>;
		pinctrl-names = "default";

		clocks = <&txmacro>;
		clock-names = "iface";

		resets = <&lpasscc 0>;
		reset-names = "swr_audio_cgcr";

		label = "VA_TX";

		qcom,din-ports = <3>;
		qcom,dout-ports = <0>;

		qcom,ports-sinterval-low =
		/bits/ 8 <0x03 0x03 0x03>;
		qcom,ports-offset1 =
		/bits/ 8 <0x01 0x02 0x01>;
		qcom,ports-offset2 =
		/bits/ 8 <0x00 0x00 0x00>;
		qcom,ports-hstart =
		/bits/ 8 <0xff 0xff 0xff>;
		qcom,ports-hstop =
		/bits/ 8 <0xff 0xff 0xff>;
		qcom,ports-word-length =
		/bits/ 8 <0xff 0xff 0xff>;
		qcom,ports-block-pack-mode =
		/bits/ 8 <0xff 0xff 0xff>;
		qcom,ports-block-group-count =
		/bits/ 8 <0xff 0xff 0xff>;
		qcom,ports-lane-control =
		/bits/ 8 <0x00 0x00 0x00>;

		#sound-dai-cells = <1>;
		#address-cells = <2>;
		#size-cells = <0>;

		wcd937x_tx: codec@0,3 {
			compatible = "sdw20217010a00";
			reg = <0 3>;

			/*
			 * WCD9370 TX Port 1 (ADC1)               <=> SWR Port 1
			 * WCD9370 TX Port 2 (ADC2, 3)            <=> SWR Port 1
			 * WCD9370 TX Port 3 (DMIC0,1,2,3 & MBHC) <=> SWR Port 2
			 * WCD9370 TX Port 4 (DMIC4,5,6,7)        <=> SWR Port 3
			 */
			qcom,tx-port-mapping = <1 1 2 3>;

			/*
			 * Static channel mapping between slave and master tx
			 * port channels, in the order of slave port channels
			 * which is adc1, adc2, adc3, mic0, dmic1, mbhc,
			 * dmic2, dmic3, dmic4, dmic5, dmic6, dmic7.
			 */
			qcom,tx-channel-mapping = /bits/ 8
			<1 2 1 1 2 3 3 4 1 2 3 4>;
		};
	};

	swr1: soundwire@a610000 {
		compatible = "qcom,soundwire-v1.6.0";
		reg = <0x0 0x0a610000 0x0 0x2000>;
		interrupts = <GIC_SPI 297 IRQ_TYPE_LEVEL_HIGH>;

		pinctrl-0 = <&lpi_swr_rx_active>;
		pinctrl-names = "default";

		clocks = <&rxmacro>;
		clock-names = "iface";

		resets = <&lpass_audiocc 0>;
		reset-names = "swr_audio_cgcr";

		label = "RX";

		qcom,din-ports = <0>;
		qcom,dout-ports = <5>;

		qcom,ports-sinterval-low =
		/bits/ 8 <0x03 0x1f 0x1f 0x07 0x00>;
		qcom,ports-offset1 =
		/bits/ 8 <0x00 0x00 0x0b 0x01 0x00>;
		qcom,ports-offset2 =
		/bits/ 8 <0x00 0x00 0x0b 0x00 0x00>;
		qcom,ports-hstart =
		/bits/ 8 <0xff 0x03 0xff 0xff 0xff>;
		qcom,ports-hstop =
		/bits/ 8 <0xff 0x06 0xff 0xff 0xff>;
		qcom,ports-word-length =
		/bits/ 8 <0x01 0x07 0x04 0xff 0xff>;
		qcom,ports-block-pack-mode =
		/bits/ 8 <0xff 0x00 0x01 0xff 0xff>;
		qcom,ports-block-group-count =
		/bits/ 8 <0xff 0xff 0xff 0xff 0x00>;
		qcom,ports-lane-control =
		/bits/ 8 <0x01 0x00 0x00 0x00 0x00>;

		#sound-dai-cells = <1>;
		#address-cells = <2>;
		#size-cells = <0>;

		wcd937x_rx: codec@0,4 {
			compatible = "sdw20217010a00";
			reg = <0 4>;
			qcom,rx-port-mapping = <1 2 3 4 5>;
			qcom,rx-channel-mapping = /bits/ 8
			<1 2 1 1 2 1 1 2>;
		};
	};
};

&lpass_tlmm {
	lpi_swr_tx_active: lpi-swr-tx-active-state {
		clk-pins {
			pins = "gpio0";
			function = "swr_tx_clk";
			bias-disable;
			drive-strength = <10>;
			slew-rate = <3>;
		};

		data-pins {
			pins = "gpio1", "gpio2";
			function = "swr_tx_data";
			bias-bus-hold;
			drive-strength = <10>;
			slew-rate = <3>;
		};
	};

	lpi_swr_tx_sleep: lpi-swr-tx-sleep-state {
		clk-pins {
			pins = "gpio0";
			function = "swr_tx_clk";
			bias-pull-down;
			drive-strength = <10>;
			input-enable;
		};

		data-pins {
			pins = "gpio1", "gpio2";
			function = "swr_tx_data";
			bias-bus-hold;
			drive-strength = <10>;
			input-enable;
		};
	};

	lpi_swr_rx_active: lpi-swr-rx-active-state {
		clk-pins {
			pins = "gpio3";
			function = "swr_rx_clk";
			bias-disable;
			drive-strength = <10>;
			slew-rate = <3>;
		};

		data-pins {
			pins = "gpio4", "gpio5";
			function = "swr_rx_data";
			bias-bus-hold;
			drive-strength = <10>;
			slew-rate = <3>;
		};
	};

	lpi_swr_rx_sleep: lpi-swr-rx-sleep-state {
		clk-pins {
			pins = "gpio3";
			function = "swr_rx_clk";
			bias-pull-down;
			drive-strength = <10>;
			input-enable;
		};

		data-pins {
			pins = "gpio4", "gpio5";
			function = "swr_rx_data";
			bias-bus-hold;
			drive-strength = <10>;
			input-enable;
		};
	};

	lpi_dmic01_active: lpi-dmic01-active-state {
		clk-pins {
			pins = "gpio6";
			function = "dmic01_clk";
			drive-strength = <8>;
			output-high;
		};

		data-pins {
			pins = "gpio7";
			function = "dmic01_data";
			drive-strength = <8>;
			input-enable;
		};
	};

	lpi_dmic23_active: lpi-dmic23-active-state {
		clk-pins {
			pins = "gpio8";
			function = "dmic23_clk";
			drive-strength = <8>;
			output-high;
		};

		data-pins {
			pins = "gpio9";
			function = "dmic23_data";
			drive-strength = <8>;
			input-enable;
		};
	};
};

&adreno_smmu {
	status = "okay";
};

&gpu {
	status = "okay";

	zap-shader {
		firmware-name = "qcom/sm6225/XIAOMI/SPES/a610_zap.mdt";
	};
};

&gmu_wrapper {
	status = "okay";
};

&mdss {
	status = "okay";
};

&mdss_dsi0 {
	status = "okay";
	vdda-supply = <&pm6125_l18>;

	panel@0 {
		compatible = "samsung,s6e3fc-unknown";
		reg = <0>;

		vddio-supply = <&pm6125_l9>;

		reset-gpios = <&tlmm 82 0x01>;
		/* downstream: qcom,platform-en-gpio = <&pm6125_gpios 9 0>; */
		enable-gpios = <&pm6125_gpios 8 GPIO_ACTIVE_HIGH>;

		pinctrl-names = "default";
		pinctrl-0 = <&te_active>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in>;
};

&mdss_dsi0_phy {
	status = "okay";
};

&remoteproc_adsp {
	firmware-name = "qcom/sm6225/XIAOMI/SPESN/adsp.mbn";
	status = "okay";
};

&remoteproc_cdsp {
	firmware-name = "qcom/sm6225/XIAOMI/SPESN/cdsp.mbn";
	status = "okay";
};

&ipa {
	firmware-name = "qcom/sm6225/XIAOMI/SPESN/ipa_fws.mdt";
	status = "okay";
};

&remoteproc_mpss {
	firmware-name = "qcom/sm6225/XIAOMI/SPESN/modem.mdt";
	status = "okay";
};

&tlmm {
	rt1711h_int_n: rt1711h-int-n-state {
		pins = "gpio93";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	bq2589x_int_default: bq2589x-int-default-state {
		pins = "gpio105";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		input-enable;
	};

	bq2589x_usb_switch_default: bq2589x-usb-switch-default-state {
		pins = "gpio31";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
		output-low;
	};

	ts_int_active: ts-int-active-state {
		pins = "gpio80";
		function = "gpio";
		drive-strength = <0x08>;
		bias-pull-up;
	};

	ts_int_suspend: ts-int-suspend-state {
		pins = "gpio80";
		function = "gpio";
		drive-strength = <0x02>;
		bias-pull-down;
	};

	ts_reset_active: ts-reset-active-state {
		pins = "gpio86";
		function = "gpio";
		drive-strength = <0x08>;
		bias-pull-up;
	};

	ts_reset_suspend: ts-reset-suspend-state {
		pins = "gpio86";
		function = "gpio";
		drive-strength = <0x02>;
		bias-pull-down;
	};

	mdss_dsi_active: mdss-dsi-active-pin {
		bias-disable;
		drive-strength = <0x08>;
		function = "gpio";
		output-high;
		pins = "gpio82";
	};

	te_active: te-active-pin {
		bias-pull-down;
		drive-strength = <0x02>;
		function = "mdp_vsync";
		input-enable;
		pins = "gpio81";
	};

	wcd_reset_n: wcd-reset-n-active {
		drive-strength = <0x10>;
		output-high;
		pins = "gpio92";
		function = "gpio";
	};

	wcd_reset_n_sleep: wcd-reset-n-sleep {
		drive-strength = <0x10>;
		bias-disable;
		output-low;
		pins = "gpio92";
		function = "gpio";
	};
};

&gpi_dma0 {
	status = "okay";
};

&qupv3_id_0 {
	status = "okay";
};

&i2c2 {
	status = "okay";

	// touchscreen@38 {
	// 	compatible = "focaltech,ft3518";
	// 	reg = <0x38>;
	// 	pinctrl-0 = <&ts_int_active &ts_reset_active>;
	// 	pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
	// 	pinctrl-names = "default", "sleep";
	// 	reset-gpios = <&tlmm 86 GPIO_ACTIVE_LOW>;
	// 	interrupt-parents = <&tlmm>;
	// 	interrupts = <89 IRQ_TYPE_EDGE_FALLING>;
	// 	vcc-supply = <&pm6125_l9>;
	// 	touchscreen-size-x = "1080";
	// 	touchscreen-size-y = "2400";
	// };

	touchscreen@38 {
		compatible = "focaltech,fts";
		focaltech,avdd-gpio = <&tlmm 0x62 0x00>;
		focaltech,display-coords = <0x00 0x00 0x438 0x960>;
		focaltech,irq-gpio = <&tlmm 0x50 GPIO_ACTIVE_LOW>;
		focaltech,max-touch-number = <0x0a>;
		focaltech,reset-gpio = <&tlmm 0x56 0x01>;
		interrupt-parent = <&tlmm>;
		interrupts = <0x59 0x02>;
		pinctrl-0 = <&ts_int_active &ts_reset_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
		reg = <0x38>;
		status = "ok";
		vcc_i2c-supply = <&pm6125_l9>;
	};
};

&i2c1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	left_spkr: aw87xxx_pa_58@58 {
		compatible = "awinic,aw87xxx_pa";
		dev_index = <0x01>;
		reg = <0x58>;
		reset-gpio = <&tlmm 106 0x00>;
		sound-name-prefix = "SpkrLeft";
		status = "okay";
		#sound-dai-cells = <0>;
	};

	right_spkr: aw87xxx_pa_5B@5b {
		compatible = "awinic,aw87xxx_pa";
		dev_index = <0x00>;
		reg = <0x5b>;
		reset-gpio = <&tlmm 35 0x00>;
		sound-name-prefix = "SpkrRight";
		status = "okay";
		#sound-dai-cells = <0>;
	};

	rt1711h@4e {
		compatible = "richtek,rt1711h";
		reg = <0x4e>;

		interrupt-parent = <&tlmm>;
		interrupts = <93 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&rt1711h_int_n>;

		status = "okay";

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "sink";

			source-pdos = <PDO_FIXED(5000, 900, PDO_FIXED_USB_COMM | PDO_FIXED_DUAL_ROLE)>;
			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM | PDO_FIXED_DUAL_ROLE) PDO_FIXED(9000, 3000, 0) PDO_FIXED(12000, 2250, 0) PDO_FIXED(20000, 1350, 0)>;
			op-sink-microwatt = <33000000>; /* 33W max */

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec_con_hs: endpoint {
						remote-endpoint = <&usb_dwc3_hs>;
					};
				};
			};
		};
	};

	bq25890@6a {
		compatible = "ti,bq25890";
		reg = <0x6a>;

		interrupt-parent = <&tlmm>;
		interrupts = <105 IRQ_TYPE_EDGE_FALLING>;

		pinctrl-names = "default";
		pinctrl-0 = <&bq2589x_int_default>;

		ti,charge-current = <2000000>;      /* 2A in µA */
		ti,battery-regulation-voltage = <4450000>; /* 4.45V in µV */
		ti,termination-current = <256000>;  /* 256mA in µA */
		ti,precharge-current = <128000>;    /* 128mA in µA */
		ti,minimum-sys-voltage = <3500000>; /* 3.5V in µV */
		ti,boost-voltage = <5000000>;       /* 5V boost output */
		ti,boost-max-current = <1500000>;   /* 1.5A boost */
		ti,input-current-sdp = <500000>;    /* SDP: 500mA */
		ti,input-current-cdp = <1500000>;   /* CDP: 1.5A */
		ti,input-current-dcp = <2000000>;   /* DCP: 2A */
		ti,enable-auto-dpdm;
		ti,enable-termination;
		usb-switch-gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&rpm_requests {
	regulators-0 {
		compatible = "qcom,rpm-pm6125-regulators";

		/*
		 * S3/S4 is VDD_CX
		 * S5 is VDD_MX/WCSS_MX
		 */

		pm6125_s3: s3 {
			regulator-min-microvolt = <300000>;   /* 0.3V minimum */
			regulator-max-microvolt = <1372000>;  /* 1.372V maximum */
			regulator-always-on;
		};
		pm6125_s4: s4 {
			regulator-min-microvolt = <300000>;   /* 0.3V minimum */
			regulator-max-microvolt = <1372000>;  /* 1.372V maximum */
			regulator-always-on;
		};

		pm6125_s6: s6 {
			regulator-min-microvolt = <400000>;
			regulator-max-microvolt = <1419000>;
		};

		pm6125_s7: s7 {
			regulator-min-microvolt = <1569000>;
			regulator-max-microvolt = <2040000>;
		};

		pm6125_s8: s8 {
			regulator-min-microvolt = <1060000>;
			regulator-max-microvolt = <1170000>;
		};

		pm6125_l1: l1 {
			regulator-min-microvolt = <950000>;
			regulator-max-microvolt = <1150000>;
		};

		pm6125_l4: l4 {
			regulator-min-microvolt = <720000>;
			regulator-max-microvolt = <1050000>;
		};

		pm6125_l5: l5 {
			regulator-min-microvolt = <1648000>;
			/* 3.056V capped to 2.96V for SDHCI */
			regulator-max-microvolt = <3200000>;
			regulator-allow-set-load;
			/* Broken hw, this one can't be turned off or SDHCI will break! */
			regulator-always-on;
		};

		pm6125_l6: l6 {
			regulator-min-microvolt = <570000>;
			regulator-max-microvolt = <650000>;
		};

		pm6125_l7: l7 {
			/* 1.2V-1.304V fixed at 1.256V for SDHCI bias */
			regulator-min-microvolt = <1256000>;
			regulator-max-microvolt = <1256000>;
			/*
			 * TODO: SDHCI seems to also work with this one turned off, however
			 * there exists a possibility that it may not work with some very
			 * specific SDCard types, perhaps validating this against a wide
			 * range of models could rule that out, saving some power would
			 * certainly be nice..
			 */
			regulator-always-on;
		};

		pm6125_l8: l8 {
			regulator-min-microvolt = <400000>;
			regulator-max-microvolt = <728000>;
		};

		pm6125_l9: l9 {
			regulator-min-microvolt = <1504000>;
			regulator-max-microvolt = <2000000>;
			regulator-always-on;
		};

		pm6125_l10: l10 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1900000>;
		};

		pm6125_l11: l11 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1950000>;
		};

		pm6125_l12: l12 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <1980000>;
		};

		pm6125_l13: l13 {
			regulator-min-microvolt = <1504000>;
			regulator-max-microvolt = <2000000>;
		};

		pm6125_l14: l14 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1900000>;
		};

		pm6125_l15: l15 {
			regulator-min-microvolt = <2700000>;
			regulator-max-microvolt = <3544000>;
		};

		pm6125_l16: l16 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1900000>;
		};

		pm6125_l17: l17 {
			regulator-min-microvolt = <1220000>;
			regulator-max-microvolt = <1304000>;
		};

		pm6125_l18: l18 {
			/* 1.104V-1.312V fixed @ 1.232V for DSIPHY, matches
			 * downstream khaje-regulator (init 1232000) and the
			 * downstream DSI vdda-1p2 1232000 supply entry. */
			regulator-min-microvolt = <1232000>;
			regulator-max-microvolt = <1232000>;
		};

		pm6125_l19: l19 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <3300000>;
		};

		pm6125_l20: l20 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <3300000>;
		};

		pm6125_l21: l21 {
			regulator-min-microvolt = <1600000>;
			regulator-max-microvolt = <3544000>;
		};

		pm6125_l22: l22 {
			regulator-min-microvolt = <2950000>;
			/* 3.304V capped to 2.96V for SDHCI */
			regulator-max-microvolt = <3300000>;
			regulator-allow-set-load;
			/* Broken hw, this one can't be turned off or SDHCI will break! */
			regulator-always-on;
		};

		pm6125_l23: l23 {
			regulator-min-microvolt = <3200000>;
			regulator-max-microvolt = <3400000>;
		};

		pm6125_l24: l24 {
			regulator-min-microvolt = <2700000>;
			regulator-max-microvolt = <3544000>;
		};
	};
};

&pm6125_gpios {
	vol_up_n: vol-up-n-state {
		pins = "gpio5";
		function = "normal";
		power-source = <0>;
		bias-pull-up;
		input-enable;
	};

	disp_bias_en_default: disp-bias-en-default-state {
		pins = "gpio9";
		function = "normal";
		power-source = <0>;
		bias-disable;
	};
};

&pm6125_rtc {
	status = "okay";
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

&sdc2_state_off {
	cd-pins {
		pins = "gpio88";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

&sdc2_state_on {
	cd-pins {
		pins = "gpio88";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};
};

&sdhc_2 {
	pinctrl-0 = <&sdc2_state_on>;
	pinctrl-1 = <&sdc2_state_off>;
	pinctrl-names = "default", "sleep";

	//cd-gpios = <&tlmm 88 GPIO_ACTIVE_LOW>;

	vmmc-supply = <&pm6125_l22>;
	vqmmc-supply = <&pm6125_l5>;

	status = "okay";
};

&sleep_clk {
	clock-frequency = <32764>;
};

&ufs_mem_hc {
	vcc-supply = <&pm6125_l24>;
	vcc-max-microamp = <800000>;
	vccq2-supply = <&pm6125_l11>;
	vccq2-max-microamp = <800000>;
	vdd-hba-supply = <&pm6125_l18>; // ??? sus
	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&pm6125_l4>;
	vdda-phy-max-microamp = <0x14ec4>;
	vdda-pll-supply = <&pm6125_l18>;
	status = "okay";
	vdda-pll-max-microamp = <0x477c>;
};

&usb {
	status = "okay";
	qcom,select-utmi-as-pipe-clk;
};

&usb_dwc3 {
	phys = <&usb_hsphy>;
	phy-names = "usb2-phy";
	maximum-speed = "high-speed";
	dr_mode = "otg";

	ports {
		port@0 {
			usb_dwc3_hs: endpoint {
				remote-endpoint = <&typec_con_hs>;
			};
		};
	};
};

&usb_hsphy {
	vdd-supply = <&pm6125_l4>;
	vdda-pll-supply = <&pm6125_l12>;
	vdda-phy-dpdm-supply = <&pm6125_l15>;
	status = "okay";
};

// &usb_qmpphy {
// 	vdda-phy-supply = <&pm6125_l4>;
// 	vdda-pll-supply = <&pm6125_l12>;
// 	status = "okay";
// };

&wifi {
	vdd-0.8-cx-mx-supply = <&pm6125_l8>;
	vdd-1.8-xo-supply = <&pm6125_l16>;
	vdd-1.3-rfa-supply = <&pm6125_l17>;
	vdd-3.3-ch0-supply = <&pm6125_l23>;
	status = "okay";
};

&uart3 {
	pinctrl-0 = <&qup_uart3_4pin>;
	status = "okay";

	bluetooth {
		compatible = "qcom,wcn3990-bt";

		vddio-supply = <&pm6125_l9>;
		vddxo-supply = <&pm6125_l16>;
		vddrf-supply = <&pm6125_l17>;
		vddch0-supply = <&pm6125_l23>;
	};
};

&xo_board {
	clock-frequency = <19200000>;
};
