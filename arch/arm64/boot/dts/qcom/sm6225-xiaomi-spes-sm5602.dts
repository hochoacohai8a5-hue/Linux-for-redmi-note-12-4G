/dts-v1/;

#include <dt-bindings/usb/pd.h>
#include <dt-bindings/sound/qcom,q6afe.h>
#include <dt-bindings/sound/qcom,q6asm.h>
#include "sm6225.dtsi"
#include "pm6125.dtsi"

/ {
	model = "Xiaomi Redmi Note 11 (SM5602)";
	compatible = "xiaomi,spes", "qcom,sm6225";
	chassis-type = "handset";

	/* required for bootloader to select correct board */
	qcom,msm-id = <518 0x10000>;
	qcom,board-id = <0x40022 0>;
	qcom,pmic-id = <0x2D 0x0 0x0 0x0>;

	aliases {
		serial0 = &uart3;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&vol_up_n>;
		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pm6125_gpios 5 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};

	/* Xiaomi battery authentication over bit-banged 1-wire (gpio108).
	 * Ported from downstream spes-sm5602.dtsi. */
	onewire_gpio: onewire-gpio {
		compatible = "xiaomi,onewire_gpio";
		label = "xm_onewire";
		xiaomi,version = <1>;
		/* Mainline gpiolib only matches hyphenated -gpios/-gpio
		 * names; downstream xiaomi,ow_gpio is kept as a comment
		 * for reference. Values/pins are unchanged. */
		xiaomi,ow-gpios = <&tlmm 108 GPIO_ACTIVE_HIGH>;
		xiaomi,gpio_number = <108>;
		mi,onewire-gpio-cfg-addr = <0x96c000 0x04>;
		pinctrl-names = "onewire_active", "onewire_sleep";
		pinctrl-0 = <&onewire_gpio_active>;
		pinctrl-1 = <&onewire_gpio_sleep>;
		status = "okay";
	};

	maxim_ds28e16: ds28e16 {
		compatible = "maxim,ds28e16";
		label = "max_ds28e16";
		maxim,version = <1>;
		status = "okay";
	};

	/* Xiaomi charger policy: aggregates bms + main buck into the
	 * user-visible battery/usb supplies; SW-JEITA + thermal + pump
	 * coordination. Tables ported from downstream spes-sm5602.dtsi. */
	nopmi_chg: charger-policy {
		compatible = "qcom,nopmi-chg";
		status = "okay";
		main-charger = <&bq25890>;
		pd-source = <&rt1711h>;
		qcom,fv-max-uv = <4400000>;
		/* Divider-pump engage thresholds (no downstream source for
		 * these; conservative: fixed 9V-class PD only). */
		nopmi,pump-min-uv = <9000000>;
		nopmi,pump-max-uv = <10000000>;
		nopmi,pump-min-ua = <2000000>;
		nopmi,pump-max-soc = <95>;
		enable_sw_jeita;
		jeita_temp_above_t4_cv = <4100>;
		jeita_temp_t3_to_t4_cv = <4100>;
		jeita_temp_t2_to_t3_cv = <4450>;
		jeita_temp_t1p5_to_t2_cv = <4450>;
		jeita_temp_t1_to_t1p5_cv = <4450>;
		jeita_temp_t0_to_t1_cv = <4450>;
		jeita_temp_tn1_to_t0_cv = <4450>;
		jeita_temp_below_t0_cv = <4450>;
		temp_t4_thres = <60>;
		temp_t4_thres_minus_x_degree = <58>;
		temp_t3_thres = <0x30>;
		temp_t3_thres_minus_x_degree = <46>;
		temp_t2_thres = <15>;
		temp_t2_thres_plus_x_degree = <0x11>;
		temp_t1p5_thres = <10>;
		temp_t1p5_thres_plus_x_degree = <11>;
		temp_t1_thres = <5>;
		temp_t1_thres_plus_x_degree = <6>;
		temp_t0_thres = <0>;
		temp_t0_thres_plus_x_degree = <1>;
		temp_tn1_thres = <0xfffffff6>;
		temp_tn1_thres_plus_x_degree = <0xfffffff7>;
		temp_neg_10_thres = <0xfffffff6>;
		temp_t3_to_t4_fcc = <2350>;
		temp_t2_to_t3_fcc = <0x173e>;
		temp_t1p5_to_t2_fcc = <3900>;
		temp_t1_to_t1p5_fcc = <2400>;
		temp_t0_to_t1_fcc = <950>;
		temp_tn1_to_t0_fcc = <490>;
		nopmi,thermal-mitigation = <5950000 5400000 5000000 4500000 4000000 3700000 3500000 3000000 2800000 2500000 2000000 1500000 1000000 800000 500000  300000>;
	};

	chosen {
		bootargs = "pmos.nosplash clk_ignore_unused pd_ignore_unused";

		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		framebuffer0: framebuffer@5c000000 {
			compatible = "simple-framebuffer";
			format = "a8r8g8b8";
			height = <0x960>;
			reg = <0x00 0x5c000000 0x00 0xf00000>;
			status = "okay";
			stride = <0x10e0>;
			width = <0x438>;
		};
	};

	reserved-memory {};

	sound {
		compatible = "qcom,qrb4210-rb2-sndcard";
		model = "SM6225-WCD9370-WSA8810-Speaker-DMIC";
		audio-routing =
				"AMIC1", "MIC BIAS1",
				"AMIC2", "MIC BIAS2",
				"AMIC3", "MIC BIAS3",

				"IN1_HPHL", "HPHL_OUT",
				"IN2_HPHR", "HPHR_OUT",
				"IN3_AUX", "AUX_OUT",

				"VA DMIC0", "VA MIC BIAS1",
				"VA DMIC1", "VA MIC BIAS1",
				"VA DMIC2", "VA MIC BIAS3",
				"VA DMIC3", "VA MIC BIAS3",

				"VA SWR_MIC0", "ADC1_OUTPUT",
				"VA SWR_MIC4", "ADC2_OUTPUT",
				"VA SWR_MIC5", "ADC3_OUTPUT",

				"TX SWR_INPUT0", "ADC1_OUTPUT",
				"TX SWR_INPUT4", "ADC2_OUTPUT",

				"SpkrLeft IN", "AUX",
				"SpkrRight IN", "AUX";

		aux-devs = <&left_spkr &right_spkr>;

		mm1-dai-link {
			link-name = "MultiMedia1";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
			};
		};

		mm2-dai-link {
			link-name = "MultiMedia2";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
			};
		};

		mm3-dai-link {
			link-name = "MultiMedia3";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
			};
		};

		wcd-playback-dai-link {
			link-name = "WCD Playback";

			cpu {
				sound-dai = <&q6afedai RX_CODEC_DMA_RX_0>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd937x 0>,
				<&swr1 0>,
				<&rxmacro 0>;
			};
		};

		// spk-dai-link {
		// 	link-name = "Speaker Playback";
		// 	cpu {
		// 		sound-dai = <&q6afedai SLIMBUS_0_RX>;
		// 	};
		// 	platform {
		// 		sound-dai = <&q6routing>;
		// 	};
		// 	codec {
		// 		sound-dai = <&left_spkr>, <&right_spkr>;
		// 	};
		// };

		wcd-capture-dai-link {
			link-name = "WCD Capture";

			cpu {
				sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd937x 1>,
				<&swr0 0>,
				<&txmacro 0>;
			};
		};

		va-dai-link {
			link-name = "VA Capture";

			cpu {
				sound-dai = <&q6afedai VA_CODEC_DMA_TX_0>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&vamacro 0>;
			};
		};
	};
};

&soc {
	rxmacro: codec@a600000 {
		compatible = "qcom,sm6115-lpass-rx-macro";
		reg = <0x0 0x0a600000 0x0 0x1000>;
		#clock-cells = <0>;
		#sound-dai-cells = <1>;
		clocks = <&q6afecc LPASS_CLK_ID_RX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_RX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&vamacro>;
		clock-names = "mclk", "npl", "dcodec", "fsgen";
		clock-output-names = "mclk";
		status = "okay";
	};

	txmacro: codec@a620000 {
		compatible = "qcom,sm6115-lpass-tx-macro";
		reg = <0x0 0x0a620000 0x0 0x1000>;
		qcom,dmic-sample-rate = <600000>;
		#clock-cells = <0>;
		#sound-dai-cells = <1>;
		pinctrl-0 = <&lpi_dmic01_active &lpi_dmic23_active>;
		pinctrl-names = "default";
		clocks = <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_TX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&vamacro>;
		clock-names = "mclk", "npl", "dcodec", "fsgen";
		clock-output-names = "mclk";
		status = "okay";
	};

	vamacro: codec@a730000 {
		compatible = "qcom,sm6115-lpass-va-macro";
		reg = <0x0 0x0a730000 0x0 0x1000>;
		qcom,dmic-sample-rate = <600000>;
		#clock-cells = <0>;
		#sound-dai-cells = <1>;
		clocks = <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_TX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
		clock-names = "mclk", "dcodec", "npl";
		clock-output-names = "fsgen";
		status = "okay";
	};

	lpass_audiocc: clock-controller@a6a9000 {
		compatible = "qcom,sm6115-lpassaudiocc";
		reg = <0x0 0x0a6a9000 0x0 0x1000>;
		#reset-cells = <1>;

		status = "okay";
	};

	lpasscc: clock-controller@a7ec000 {
		compatible = "qcom,sm6115-lpasscc";
		reg = <0x0 0x0a7ec000 0x0 0x1000>;
		#reset-cells = <1>;

		status = "okay";
	};

	wcd937x: codec {
		compatible = "qcom,wcd9370-codec";
		pinctrl-names = "default";
		pinctrl-0 = <&wcd_reset_n>;
		reset-gpios = <&tlmm 92 GPIO_ACTIVE_LOW>;
		vdd-buck-supply = <&pm6125_l14>;
		vdd-rxtx-supply = <&pm6125_l9>;
		vdd-px-supply = <&pm6125_l9>;
		qcom,micbias1-microvolt = <1800000>;
		qcom,micbias2-microvolt = <1800000>;
		qcom,micbias3-microvolt = <1800000>;
		qcom,rx-device = <&wcd937x_rx>;
		qcom,tx-device = <&wcd937x_tx>;
		#sound-dai-cells = <1>;
	};

	swr0: soundwire@a740000 {
		compatible = "qcom,soundwire-v1.6.0";
		reg = <0x0 0x0a740000 0x0 0x2000>;
		interrupts = <GIC_SPI 296 IRQ_TYPE_LEVEL_HIGH>,
		<GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>;

		pinctrl-0 = <&lpi_swr_tx_active>;
		pinctrl-names = "default";

		clocks = <&txmacro>;
		clock-names = "iface";

		resets = <&lpasscc 0>;
		reset-names = "swr_audio_cgcr";

		label = "VA_TX";

		qcom,din-ports = <3>;
		qcom,dout-ports = <0>;

		qcom,ports-sinterval-low =
		/bits/ 8 <0x03 0x03 0x03>;
		qcom,ports-offset1 =
		/bits/ 8 <0x01 0x02 0x01>;
		qcom,ports-offset2 =
		/bits/ 8 <0x00 0x00 0x00>;
		qcom,ports-hstart =
		/bits/ 8 <0xff 0xff 0xff>;
		qcom,ports-hstop =
		/bits/ 8 <0xff 0xff 0xff>;
		qcom,ports-word-length =
		/bits/ 8 <0xff 0xff 0xff>;
		qcom,ports-block-pack-mode =
		/bits/ 8 <0xff 0xff 0xff>;
		qcom,ports-block-group-count =
		/bits/ 8 <0xff 0xff 0xff>;
		qcom,ports-lane-control =
		/bits/ 8 <0x00 0x00 0x00>;

		#sound-dai-cells = <1>;
		#address-cells = <2>;
		#size-cells = <0>;

		wcd937x_tx: codec@0,3 {
			compatible = "sdw20217010a00";
			reg = <0 3>;

			/*
			 * WCD9370 TX Port 1 (ADC1)               <=> SWR Port 1
			 * WCD9370 TX Port 2 (ADC2, 3)            <=> SWR Port 1
			 * WCD9370 TX Port 3 (DMIC0,1,2,3 & MBHC) <=> SWR Port 2
			 * WCD9370 TX Port 4 (DMIC4,5,6,7)        <=> SWR Port 3
			 */
			qcom,tx-port-mapping = <1 1 2 3>;

			/*
			 * Static channel mapping between slave and master tx
			 * port channels, in the order of slave port channels
			 * which is adc1, adc2, adc3, mic0, dmic1, mbhc,
			 * dmic2, dmic3, dmic4, dmic5, dmic6, dmic7.
			 */
			qcom,tx-channel-mapping = /bits/ 8
			<1 2 1 1 2 3 3 4 1 2 3 4>;
		};
	};

	swr1: soundwire@a610000 {
		compatible = "qcom,soundwire-v1.6.0";
		reg = <0x0 0x0a610000 0x0 0x2000>;
		interrupts = <GIC_SPI 297 IRQ_TYPE_LEVEL_HIGH>;

		pinctrl-0 = <&lpi_swr_rx_active>;
		pinctrl-names = "default";

		clocks = <&rxmacro>;
		clock-names = "iface";

		resets = <&lpass_audiocc 0>;
		reset-names = "swr_audio_cgcr";

		label = "RX";

		qcom,din-ports = <0>;
		qcom,dout-ports = <5>;

		qcom,ports-sinterval-low =
		/bits/ 8 <0x03 0x1f 0x1f 0x07 0x00>;
		qcom,ports-offset1 =
		/bits/ 8 <0x00 0x00 0x0b 0x01 0x00>;
		qcom,ports-offset2 =
		/bits/ 8 <0x00 0x00 0x0b 0x00 0x00>;
		qcom,ports-hstart =
		/bits/ 8 <0xff 0x03 0xff 0xff 0xff>;
		qcom,ports-hstop =
		/bits/ 8 <0xff 0x06 0xff 0xff 0xff>;
		qcom,ports-word-length =
		/bits/ 8 <0x01 0x07 0x04 0xff 0xff>;
		qcom,ports-block-pack-mode =
		/bits/ 8 <0xff 0x00 0x01 0xff 0xff>;
		qcom,ports-block-group-count =
		/bits/ 8 <0xff 0xff 0xff 0xff 0x00>;
		qcom,ports-lane-control =
		/bits/ 8 <0x01 0x00 0x00 0x00 0x00>;

		#sound-dai-cells = <1>;
		#address-cells = <2>;
		#size-cells = <0>;

		wcd937x_rx: codec@0,4 {
			compatible = "sdw20217010a00";
			reg = <0 4>;
			qcom,rx-port-mapping = <1 2 3 4 5>;
			qcom,rx-channel-mapping = /bits/ 8
			<1 2 1 1 2 1 1 2>;
		};
	};
};

&lpass_tlmm {
	lpi_swr_tx_active: lpi-swr-tx-active-state {
		clk-pins {
			pins = "gpio0";
			function = "swr_tx_clk";
			bias-disable;
			drive-strength = <10>;
			slew-rate = <3>;
		};

		data-pins {
			pins = "gpio1", "gpio2";
			function = "swr_tx_data";
			bias-bus-hold;
			drive-strength = <10>;
			slew-rate = <3>;
		};
	};

	lpi_swr_tx_sleep: lpi-swr-tx-sleep-state {
		clk-pins {
			pins = "gpio0";
			function = "swr_tx_clk";
			bias-pull-down;
			drive-strength = <10>;
			input-enable;
		};

		data-pins {
			pins = "gpio1", "gpio2";
			function = "swr_tx_data";
			bias-bus-hold;
			drive-strength = <10>;
			input-enable;
		};
	};

	lpi_swr_rx_active: lpi-swr-rx-active-state {
		clk-pins {
			pins = "gpio3";
			function = "swr_rx_clk";
			bias-disable;
			drive-strength = <10>;
			slew-rate = <3>;
		};

		data-pins {
			pins = "gpio4", "gpio5";
			function = "swr_rx_data";
			bias-bus-hold;
			drive-strength = <10>;
			slew-rate = <3>;
		};
	};

	lpi_swr_rx_sleep: lpi-swr-rx-sleep-state {
		clk-pins {
			pins = "gpio3";
			function = "swr_rx_clk";
			bias-pull-down;
			drive-strength = <10>;
			input-enable;
		};

		data-pins {
			pins = "gpio4", "gpio5";
			function = "swr_rx_data";
			bias-bus-hold;
			drive-strength = <10>;
			input-enable;
		};
	};

	lpi_dmic01_active: lpi-dmic01-active-state {
		clk-pins {
			pins = "gpio6";
			function = "dmic01_clk";
			drive-strength = <8>;
			output-high;
		};

		data-pins {
			pins = "gpio7";
			function = "dmic01_data";
			drive-strength = <8>;
			input-enable;
		};
	};

	lpi_dmic23_active: lpi-dmic23-active-state {
		clk-pins {
			pins = "gpio8";
			function = "dmic23_clk";
			drive-strength = <8>;
			output-high;
		};

		data-pins {
			pins = "gpio9";
			function = "dmic23_data";
			drive-strength = <8>;
			input-enable;
		};
	};
};

&adreno_smmu {
	status = "okay";
};

&gpu {
	status = "okay";

	zap-shader {
		firmware-name = "qcom/sm6225/XIAOMI/SPES/a610_zap.mdt";
	};
};

&gmu_wrapper {
	status = "okay";
};

&mdss {
	status = "okay";
};

&mdss_dsi0 {
	status = "okay";
	vdda-supply = <&pm6125_l18>;

	panel@0 {
		compatible = "samsung,s6e3fc-unknown";
		reg = <0>;

		vddio-supply = <&pm6125_l9>;

		reset-gpios = <&tlmm 82 0x01>;
		/* downstream: qcom,platform-en-gpio = <&pm6125_gpios 9 0>; */
		enable-gpios = <&pm6125_gpios 8 GPIO_ACTIVE_HIGH>;

		pinctrl-names = "default";
		pinctrl-0 = <&te_active>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in>;
};

&mdss_dsi0_phy {
	status = "okay";
};

&remoteproc_adsp {
	firmware-name = "qcom/sm6225/XIAOMI/SPESN/adsp.mbn";
	status = "okay";
};

&remoteproc_cdsp {
	firmware-name = "qcom/sm6225/XIAOMI/SPESN/cdsp.mbn";
	status = "okay";
};

&ipa {
	firmware-name = "qcom/sm6225/XIAOMI/SPESN/ipa_fws.mdt";
	status = "okay";
};

&remoteproc_mpss {
	firmware-name = "qcom/sm6225/XIAOMI/SPESN/modem.mdt";
	status = "okay";
};

&tlmm {
	rt1711h_int_n: rt1711h-int-n-state {
		pins = "gpio93";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	bq2589x_int_default: bq2589x-int-default-state {
		pins = "gpio105";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		input-enable;
	};

	bq2589x_usb_switch_default: bq2589x-usb-switch-default-state {
		pins = "gpio31";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
		output-low;
	};

	ts_int_active: ts-int-active-state {
		pins = "gpio80";
		function = "gpio";
		drive-strength = <0x08>;
		bias-pull-up;
	};

	ts_int_suspend: ts-int-suspend-state {
		pins = "gpio80";
		function = "gpio";
		drive-strength = <0x02>;
		bias-pull-down;
	};

	ts_reset_active: ts-reset-active-state {
		pins = "gpio86";
		function = "gpio";
		drive-strength = <0x08>;
		bias-pull-up;
	};

	ts_reset_suspend: ts-reset-suspend-state {
		pins = "gpio86";
		function = "gpio";
		drive-strength = <0x02>;
		bias-pull-down;
	};

	mdss_dsi_active: mdss-dsi-active-pin {
		bias-disable;
		drive-strength = <0x08>;
		function = "gpio";
		output-high;
		pins = "gpio82";
	};

	te_active: te-active-pin {
		bias-pull-down;
		drive-strength = <0x02>;
		function = "mdp_vsync";
		input-enable;
		pins = "gpio81";
	};

	wcd_reset_n: wcd-reset-n-active {
		drive-strength = <0x10>;
		output-high;
		pins = "gpio92";
		function = "gpio";
	};

	wcd_reset_n_sleep: wcd-reset-n-sleep {
		drive-strength = <0x10>;
		bias-disable;
		output-low;
		pins = "gpio92";
		function = "gpio";
	};

	onewire_gpio_active: onewire-gpio-active-state {
		pins = "gpio108";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	onewire_gpio_sleep: onewire-gpio-sleep-state {
		pins = "gpio108";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	sc8551_int_default: sc8551-int-default-state {
		pins = "gpio84";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		input-enable;
	};
};

&gpi_dma0 {
	status = "okay";
};

&qupv3_id_0 {
	status = "okay";
};

&i2c2 {
	status = "okay";

	// touchscreen@38 {
	// 	compatible = "focaltech,ft3518";
	// 	reg = <0x38>;
	// 	pinctrl-0 = <&ts_int_active &ts_reset_active>;
	// 	pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
	// 	pinctrl-names = "default", "sleep";
	// 	reset-gpios = <&tlmm 86 GPIO_ACTIVE_LOW>;
	// 	interrupt-parents = <&tlmm>;
	// 	interrupts = <89 IRQ_TYPE_EDGE_FALLING>;
	// 	vcc-supply = <&pm6125_l9>;
	// 	touchscreen-size-x = "1080";
	// 	touchscreen-size-y = "2400";
	// };

	touchscreen@38 {
		compatible = "focaltech,fts";
		focaltech,avdd-gpio = <&tlmm 0x62 0x00>;
		focaltech,display-coords = <0x00 0x00 0x438 0x960>;
		focaltech,irq-gpio = <&tlmm 0x50 GPIO_ACTIVE_LOW>;
		focaltech,max-touch-number = <0x0a>;
		focaltech,reset-gpio = <&tlmm 0x56 0x01>;
		interrupt-parent = <&tlmm>;
		interrupts = <0x59 0x02>;
		pinctrl-0 = <&ts_int_active &ts_reset_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
		reg = <0x38>;
		status = "ok";
		vcc_i2c-supply = <&pm6125_l9>;
	};
};

&i2c1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	left_spkr: aw87xxx_pa_58@58 {
		compatible = "awinic,aw87xxx_pa";
		dev_index = <0x01>;
		reg = <0x58>;
		reset-gpio = <&tlmm 106 0x00>;
		sound-name-prefix = "SpkrLeft";
		status = "okay";
		#sound-dai-cells = <0>;
	};

	right_spkr: aw87xxx_pa_5B@5b {
		compatible = "awinic,aw87xxx_pa";
		dev_index = <0x00>;
		reg = <0x5b>;
		reset-gpio = <&tlmm 35 0x00>;
		sound-name-prefix = "SpkrRight";
		status = "okay";
		#sound-dai-cells = <0>;
	};

	rt1711h: rt1711h@4e {
		compatible = "richtek,rt1711h";
		reg = <0x4e>;

		/* Host-mode VBUS comes from the charger boost output.
		 * Without this the TCPC cannot probe on mainline. */
		vbus-supply = <&usb_otg_vbus>;

		interrupt-parent = <&tlmm>;
		interrupts = <93 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&rt1711h_int_n>;

		status = "okay";

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "sink";

			source-pdos = <PDO_FIXED(5000, 900, PDO_FIXED_USB_COMM | PDO_FIXED_DUAL_ROLE)>;
			/* 9V max: the sc8551 divider path faults above 12V
			 * (bus-ovp threshold), so 12V/20V must not be
			 * offered even though the brick can do more.
			 * 9V/3A = 27W is the fastest standard-PD mode;
			 * Xiaomi 11V/33W needs the proprietary handshake. */
			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM | PDO_FIXED_DUAL_ROLE) PDO_FIXED(9000, 3000, 0)>;
			op-sink-microwatt = <27000000>; /* 27W max */

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec_con_hs: endpoint {
						remote-endpoint = <&usb_dwc3_hs>;
					};
				};
			};
		};
	};

	bq25890: bq25890@6a {
		compatible = "ti,bq25890";
		reg = <0x6a>;

		interrupt-parent = <&tlmm>;
		interrupts = <105 IRQ_TYPE_EDGE_FALLING>;

		pinctrl-names = "default";
		pinctrl-0 = <&bq2589x_int_default>;

		ti,charge-current = <2000000>;      /* 2A in µA */
		ti,battery-regulation-voltage = <4450000>; /* 4.45V in µV */
		ti,termination-current = <256000>;  /* 256mA in µA */
		ti,precharge-current = <128000>;    /* 128mA in µA */
		ti,minimum-sys-voltage = <3500000>; /* 3.5V in µV */
		ti,boost-voltage = <5000000>;       /* 5V boost output */
		ti,boost-max-current = <1500000>;   /* 1.5A boost */
		ti,input-current-sdp = <500000>;    /* SDP: 500mA */
		ti,input-current-cdp = <1500000>;   /* CDP: 1.5A */
		ti,input-current-dcp = <2000000>;   /* DCP: 2A */
		ti,enable-auto-dpdm;
		ti,enable-termination;
		usb-switch-gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
		status = "okay";

		/* OTG boost output, consumed by the Type-C controller
		 * (rt1711h vbus-supply) for host-mode VBUS. No voltage
		 * constraints: the bq boost ops expose no voltage list,
		 * so fixed min/max would fail registration. */
		usb_otg_vbus: usb-otg-vbus {
			regulator-name = "usb_otg_vbus";
		};
	};

	sm5602@71 {
		compatible = "sm,sm5602";
		reg = <0x71>;
		sm,en_temp_ex;
		sm,en_batt_det;
		sm,misc = <2048>;
		sm,aging_ctrl = <289>;
		sm,cycle_cfg = <28672>;
		sm,rsns = <0>;
		sm,fg_irq_set = <2047>;
		sm,low_soc1 = <1>;
		sm,low_soc2 = <15>;
		sm,v_l_alarm = <3400>;
		sm,v_h_alarm = <4450>;
		sm,battery_table_num = <0>;
		sm,param_version = <5>;
		sm,t_l_alarm_in = <54>;
		sm,t_h_alarm_in = <1>;
		sm,t_l_alarm_ex = <54834>;
		sm,t_h_alarm_ex = <38239>;
		sm,shutdown-delay-enable;
		sm,soc_decimal_rate = <0 38 10 35 20 33 30 33 40 33 50 33 60 33 70 30 80 25 90 20 95 10>;

		battery_params {
		/* battery 0 */
			battery0,param_version = <10>;
			battery0,max_voltage_uv = <4450000>;
			battery0,battery_type = <4450 0 9932>;
			battery0,battery_table0 = <5120 6966 7259 7437 7517 7550 7565 7575 7617 7664 7706 7754 7786 7842 7918 7991 8121 8213 8313 8424 8604 8791 9041 9420>;
